# Stop Lombok looking for further config files in parent directories.
config.stopBubbling = true

# Mark every Lombok-generated member with @lombok.Generated (CLASS retention, so it is
# visible in the bytecode). JaCoCo skips methods carrying an annotation whose simple name
# is "Generated", which keeps generated getters, setters, equals, hashCode, toString and
# builders out of the coverage denominator.
#
# Without this, the dto/ model/ and document/ packages are measured almost entirely on code
# nobody wrote, and the reported coverage says nothing about the logic under test.
lombok.addLombokGeneratedAnnotation = true
